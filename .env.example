# Copier en .env et adapter (le fichier .env n'est pas versionné)
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/smartcampus
DB_USER=smartcampus
DB_PASSWORD=smartcampus_pwd

# Obligatoire hors profil dev : au moins 32 caractères aléatoires
# (ex. : openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION=1h
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION=15m

# dev = charge les comptes de test
SPRING_PROFILES_ACTIVE=dev
